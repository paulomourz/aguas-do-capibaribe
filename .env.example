# Front-end (Vite). Copie para .env.local e ajuste. Variáveis VITE_* ficam visíveis no navegador:
# nunca coloque segredos aqui.

# true (padrão) = dados simulados em memória, sem API. false = usa a API REST.
VITE_USAR_MOCK=false

# Endereço da API, incluindo o prefixo /api
VITE_API_URL=http://localhost:8080/api
