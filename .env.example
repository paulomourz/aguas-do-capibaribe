# Front-end (Vite). Copie para .env.local e ajuste. Variáveis VITE_* ficam visíveis no navegador:
# nunca coloque segredos aqui.

# Endereço da API, incluindo o prefixo /api. Sem esta linha, o site usa http://localhost:8080/api.
VITE_API_URL=http://localhost:8080/api

# Nome da lavanderia no cabeçalho do relatório em PDF
VITE_NOME_LAVANDERIA=Lavanderia Modelo do Agreste

# Modo simulado (dados de exemplo em memória, sem API). Desligado por padrão: o site sempre usa a API.
# Só para demonstração sem back-end; não use em entregas. Para ligar: VITE_USAR_MOCK=true
VITE_USAR_MOCK=false
