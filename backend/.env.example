# Copie para backend/.env e preencha. O arquivo .env NUNCA deve ir para o Git.
# Variáveis definidas no sistema têm prioridade sobre este arquivo.

# --- PostgreSQL (fornecido pelo responsável pelo banco) ---
DB_HOST=
DB_PORT=5432
DB_NAME=
# Use o usuário da aplicação, nunca o superusuário postgres. Ele é criado por
# database/seguranca-usuario-api.sql (só SELECT/INSERT/UPDATE, sem DELETE).
DB_USER=aguas_api
DB_PASSWORD=
# disable | prefer | require | verify-full (use require ou verify-full fora da rede local)
DB_SSLMODE=prefer
# Máximo de conexões abertas pela API (opcional)
DB_POOL_MAX=20

# --- Flyway (migrações do esquema, aplicadas ao subir a API) ---
# Dono do banco, que pode criar tabelas. Descomente e preencha: sem elas o Flyway usa DB_USER, e o
# aguas_api não pode criar tabelas. Não deixe a linha vazia (vazio não é o mesmo que ausente).
# FLYWAY_USER=postgres
# FLYWAY_PASSWORD=
# false = a API não aplica migrações; quem administra o banco roda "mvn flyway:migrate" (opcional)
FLYWAY_ATIVO=true
# Só uma vez, no banco que já existia antes do Flyway (ver database/LEIA-ME.md). Depois, volte para false.
FLYWAY_BASELINE=false

# --- Autenticação ---
# Pelo menos 32 caracteres aleatórios. Gere com: openssl rand -base64 48
JWT_SECRET=
# Validade do login (sem renovação automática)
JWT_EXPIRACAO=8h

# --- Administrador principal ---
# Criado na inicialização se ainda não existir. Depois disso a senha é ignorada (troque-a pelo site).
ADMIN_LOGIN=capibaribe.admin
ADMIN_SENHA=

# --- Limite de requisições por minuto (opcional): login por IP e registro de lotes por usuário ---
LIMITE_LOGIN_POR_MINUTO=5
LIMITE_LOTES_POR_MINUTO=60
# Cabeçalho com o IP real, se houver proxy na frente: X-Real-IP (Nginx) ou CF-Connecting-IP (Render)
LIMITE_CABECALHO_IP=

# --- Conta do gestor (capibaribe.gestor): criada na inicialização se esta senha estiver definida (opcional) ---
GESTOR_SENHA=

# --- Conta do sensor (sensor.wokwi): criada na inicialização se esta senha estiver definida (opcional) ---
SENSOR_SENHA=

# --- Aviso de alerta no Telegram (opcional): sem token e chat, fica desligado ---
# Token do bot (BotFather) e id do grupo ou conversa que recebe o aviso.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Endereço do site, para a mensagem levar o link do alerta (opcional)
SITE_URL=

# --- CORS: origens do front autorizadas, separadas por vírgula. "*" é recusado. ---
# Desenvolvimento local (Vite deste projeto roda na porta 8443): http://localhost:8443
CORS_ORIGINS=http://localhost:8443

# --- Porta da API (opcional; padrão 8080) ---
SERVER_PORT=8080

# --- Swagger UI em /api/swagger-ui.html (opcional; padrão true). false desliga, por exemplo em produção ---
SWAGGER_ATIVO=true
