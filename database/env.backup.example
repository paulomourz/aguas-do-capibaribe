# Copie para database/.env.backup (ignorado pelo Git) e preencha. Use o DONO do banco, não o aguas_api.
# Um arquivo por banco: para outro, aponte BACKUP_ENV para ele (ex.: BACKUP_ENV=database/.env.backup.neon).

# --- Banco do docker compose (o serviço db não abre porta; o backup entra pela rede do compose) ---
PGHOST=db
PGDATABASE=aguas
PGUSER=postgres
# senha: docker compose exec db cat /segredos/postgres
PGPASSWORD=
BACKUP_REDE_DOCKER=aguas-do-capibaribe_default
BACKUP_PREFIXO=docker

# --- Banco do PC (PostgreSQL instalado) ---
# PGHOST=localhost        (se o pg_dump não estiver instalado e rodar pelo Docker: host.docker.internal)
# PGDATABASE=aguas
# PGUSER=postgres
# PGPASSWORD=
# BACKUP_PREFIXO=pc

# --- Banco publicado no Neon (endereço e senha em docs/privado/hospedagem.md) ---
# PGHOST=<endereço do Neon>
# PGDATABASE=aguas
# PGUSER=<dono do banco no Neon>
# PGPASSWORD=
# PGSSLMODE=require
# BACKUP_PREFIXO=neon
